{
  "name": "course-ai-agents-data-analysis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:statistics-eda": "slidev slides-statistics-eda.md --port 3333 --open",
    "dev:predictive-modeling": "slidev slides-predictive-modeling.md --port 3434 --open",
    "build": "pnpm build:statistics-eda && pnpm build:predictive-modeling",
    "build:statistics-eda": "slidev build slides-statistics-eda.md --base /course-ai-agents-data-analysis/statistics-eda/ --out dist/statistics-eda",
    "build:predictive-modeling": "slidev build slides-predictive-modeling.md --base /course-ai-agents-data-analysis/predictive-modeling/ --out dist/predictive-modeling"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/teenyicons": "^1.2.2",
    "@slidev/cli": "^52.17.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/types": "^52.18.0",
    "@types/seedrandom": "^3.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-slidev": "^1.0.5",
    "seedrandom": "^3.0.5",
    "unocss": "66.7.3"
  },
  "dependencies": {
    "@iconify-json/iconoir": "^1.2.11",
    "slidev-addon-python-runner": "^0.1.3",
    "slidev-addon-window-mockup": "^0.3.1",
    "slidev-theme-dracula": "^0.2.5"
  }
